#!/bin/sh
# grub-mkconfig snippet: load usb_mouse.mod (mouse wheel = Up/Down in the
# GRUB menu, left click = Enter). Source: ~/workspace/grub-wheel on the VM.
#
# Controlled by grubenv variables (sudo grub-editenv - set ...):
#   usb_mouse=1        load the module on every boot
#   usb_mouse_test=1   load it once, store the probe result in
#                      usb_mouse_result, then clear usb_mouse_test
# Hold Shift while GRUB starts to skip it.
set -e
[ -f /boot/grub/usb_mouse/usb_mouse.mod ] || exit 0
cat <<'EOF'
### BEGIN usb_mouse ###
set usb_mouse_load=0
if [ "${usb_mouse_test}" = 1 ]; then
  set usb_mouse_test=0
  save_env usb_mouse_test
  set usb_mouse_result="started, no result (hang or crash?)"
  save_env usb_mouse_result
  set usb_mouse_load=2
elif [ "${usb_mouse}" = 1 ]; then
  set usb_mouse_load=1
fi
if [ "${usb_mouse_load}" != 0 ]; then
  insmod keystatus
  if keystatus --shift; then
    echo "usb_mouse: skipped (Shift held)"
  elif hashsum --hash sha256 --prefix "${prefix}/i386-pc" --check "${prefix}/usb_mouse/abi.sha256"; then
    insmod ehci
    insmod usb_keyboard
    insmod "${prefix}/usb_mouse/usb_mouse.mod"
    if [ "${usb_mouse_load}" = 2 ]; then
      usb_mouse_probe usb_mouse_result
      save_env usb_mouse_result
    fi
  else
    echo "usb_mouse: GRUB modules differ from the ones usb_mouse.mod was built for; not loading it"
    if [ "${usb_mouse_load}" = 2 ]; then
      set usb_mouse_result="abi mismatch"
      save_env usb_mouse_result
    fi
  fi
fi
### END usb_mouse ###
EOF
